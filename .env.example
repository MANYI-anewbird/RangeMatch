# Copy this file to .env and replace the placeholder values locally.
# Never commit the real .env file.
MIREYE_API_BASE_URL=https://replace-with-real-base-url
# Canonical credential name (Mireye docs). Dashboard Bearer token; ~90-day default expiry.
MIREYE_API_TOKEN=replace-with-real-secret
# Legacy alias still accepted by the adapter if TOKEN is unset:
# MIREYE_API_KEY=replace-with-real-secret

# Competition Demo ports: API 8001, UI 5273 (web/vite.config.ts strictPort).
# Optional constrained LLM (defaults to FIXTURE; never commit real keys)
# RANGEMATCH_LLM_PROVIDER=FIXTURE
# RANGEMATCH_LLM_PROVIDER=DEEPSEEK
# RANGEMATCH_LLM_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=replace-with-real-secret
# RANGEMATCH_LLM_PROVIDER=OPENAI
# RANGEMATCH_LLM_MODEL=gpt-4o-mini
# RANGEMATCH_SEARCH_MODEL=gpt-5.6-terra
# RANGEMATCH_LLM_API_KEY=replace-with-real-secret
# OPENAI_API_KEY=replace-with-real-secret
# RANGEMATCH_LLM_BASE_URL=https://api.deepseek.com/v1
# RANGEMATCH_LLM_TEMPERATURE=0
