{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rangematch.local/schemas/advisor_operating_conclusion.schema.json",
  "title": "RangeMatchAdvisorOperatingConclusion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conclusion_id",
    "run_id",
    "deal_context_version",
    "operating_profile_hash",
    "status",
    "headline",
    "summary",
    "primary_constraint",
    "confidence",
    "evidence_refs",
    "knowledge_refs",
    "missing_evidence",
    "what_would_change_view",
    "next_action",
    "next_spend_class",
    "next_question",
    "source",
    "validation_status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "RANGEMATCH_ADVISOR_OPERATING_CONCLUSION@0.1.0"
    },
    "conclusion_id": { "type": "string", "minLength": 8 },
    "run_id": { "type": "string", "minLength": 8 },
    "deal_context_version": { "type": "integer", "minimum": 1 },
    "operating_profile_hash": { "type": ["string", "null"], "minLength": 64, "maxLength": 64 },
    "status": {
      "type": "string",
      "enum": [
        "CONDITIONAL",
        "EVIDENCE_SUPPORTS_NEXT_STAGE",
        "OPERATING_CLAIM_NOT_SUPPORTED",
        "BLOCKED"
      ]
    },
    "headline": { "type": "string", "minLength": 12, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 40, "maxLength": 1200 },
    "primary_constraint": { "type": "string", "minLength": 12, "maxLength": 400 },
    "confidence": { "type": "string", "enum": ["LOW", "MODERATE"] },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "knowledge_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "what_would_change_view": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    },
    "next_action": { "type": "string", "minLength": 8, "maxLength": 400 },
    "next_spend_class": {
      "type": "string",
      "enum": [
        "REMOTE_INFORMATION_REQUEST",
        "DOCUMENT_REVIEW",
        "TARGETED_FIELD_VISIT",
        "SPECIALIST_REVIEW"
      ]
    },
    "next_question": { "$ref": "#/$defs/nextQuestion" },
    "source": {
      "type": "string",
      "enum": ["LIVE_LLM", "DETERMINISTIC_FALLBACK"]
    },
    "validation_status": {
      "type": "string",
      "enum": ["PASSED", "FAILED"]
    },
    "validation_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "minLength": 8 },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "nextQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "prompt",
        "allowed_field",
        "what_would_change_view_ref"
      ],
      "properties": {
        "question_id": { "type": "string", "minLength": 3 },
        "prompt": { "type": "string", "minLength": 12, "maxLength": 280 },
        "allowed_field": { "type": "string", "minLength": 3 },
        "what_would_change_view_ref": { "type": "string", "minLength": 3 }
      }
    }
  }
}
