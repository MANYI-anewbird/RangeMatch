{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rangematch.local/schemas/mireye_environmental_profile.schema.json",
  "title": "RangeMatchMireyeEnvironmentalProfile",
  "description": "Mireye-first cattle-environment profile with per-field spatial semantics and provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "parcel_ref",
    "catalog_ref",
    "observations",
    "coverage_summary",
    "profile_hash",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mireye_environmental_profile@1.0.0"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "parcel_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parcel_resolution_id", "geometry_hash", "confirmed"],
      "properties": {
        "parcel_resolution_id": { "type": "string", "minLength": 1 },
        "geometry_hash": { "type": "string", "minLength": 1 },
        "confirmed": { "const": true }
      }
    },
    "catalog_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "manifest_hash"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "manifest_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
        "catalog_file_sha256": { "type": ["string", "null"] },
        "etag": { "type": ["string", "null"] }
      }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_field_count",
        "retrieved_field_count",
        "missing_field_count",
        "point_count",
        "parcel_count",
        "context_count",
        "rejected_by_semantics_count",
        "retrieved_by_domain"
      ],
      "properties": {
        "requested_field_count": { "type": "integer", "minimum": 0 },
        "retrieved_field_count": { "type": "integer", "minimum": 0 },
        "missing_field_count": { "type": "integer", "minimum": 0 },
        "point_count": { "type": "integer", "minimum": 0 },
        "parcel_count": { "type": "integer", "minimum": 0 },
        "context_count": { "type": "integer", "minimum": 0 },
        "rejected_by_semantics_count": { "type": "integer", "minimum": 0 },
        "retrieved_by_domain": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "profile_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projector_id", "provider", "built_at"],
      "properties": {
        "projector_id": { "type": "string", "minLength": 1 },
        "provider": { "const": "MIREYE" },
        "built_at": { "type": "string", "minLength": 1 },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "field_id",
        "domain",
        "value",
        "unit",
        "provider",
        "source_name",
        "source_url",
        "dataset_vintage",
        "fetched_at",
        "confidence",
        "status",
        "spatial_semantics",
        "temporal_semantics",
        "canonical_for_parcel_facts",
        "geometry_hash_ref"
      ],
      "properties": {
        "observation_id": { "type": "string", "minLength": 1 },
        "field_id": { "type": "string", "minLength": 1 },
        "domain": {
          "type": "string",
          "enum": [
            "FEED_VEGETATION",
            "WATER",
            "TERRAIN",
            "CLIMATE_HAZARD",
            "SOIL_ECOLOGY"
          ]
        },
        "value": {},
        "unit": { "type": ["string", "null"] },
        "provider": { "const": "MIREYE" },
        "source_name": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"] },
        "dataset_vintage": { "type": ["string", "null"] },
        "fetched_at": { "type": ["string", "null"] },
        "confidence": { "type": ["string", "number", "null"] },
        "status": {
          "type": "string",
          "enum": [
            "RETRIEVED",
            "PARTIAL",
            "MISSING",
            "SOURCE_UNAVAILABLE",
            "NOT_APPLICABLE",
            "REJECTED_BY_SEMANTICS_GATE"
          ]
        },
        "spatial_semantics": {
          "type": "string",
          "enum": ["POINT", "PARCEL", "CONTEXT"]
        },
        "temporal_semantics": { "type": ["string", "null"] },
        "canonical_for_parcel_facts": { "type": "boolean" },
        "geometry_hash_ref": { "type": ["string", "null"] },
        "rejection_reason": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
