{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rangematch.local/schemas/advisor_chat_turn.schema.json",
  "title": "RangeMatchAdvisorChatTurn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "turn_id",
    "run_id",
    "deal_context_version",
    "intent",
    "user_message",
    "judgment",
    "answer",
    "evidence_refs",
    "knowledge_refs",
    "missing_evidence",
    "suggested_follow_up",
    "source",
    "validation_status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "RANGEMATCH_ADVISOR_CHAT_TURN@0.1.0"
    },
    "turn_id": { "type": "string", "minLength": 8 },
    "run_id": { "type": "string", "minLength": 8 },
    "deal_context_version": { "type": "integer", "minimum": 1 },
    "intent": {
      "type": "string",
      "enum": [
        "OVERALL_CATTLE_CASE",
        "WATER",
        "FEED",
        "MOVEMENT",
        "ACCESS",
        "NEXT_ACTION",
        "OUT_OF_SCOPE"
      ]
    },
    "user_message": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "judgment": { "type": "string", "minLength": 12, "maxLength": 280 },
    "answer": { "type": "string", "minLength": 40, "maxLength": 1600 },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "knowledge_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "suggested_follow_up": { "type": "string", "minLength": 8, "maxLength": 280 },
    "source": {
      "type": "string",
      "enum": ["LIVE_LLM", "DETERMINISTIC_FALLBACK"]
    },
    "validation_status": {
      "type": "string",
      "enum": ["PASSED", "FAILED"]
    },
    "validation_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "minLength": 8 },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
