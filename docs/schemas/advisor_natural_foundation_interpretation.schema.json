{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rangematch.local/schemas/advisor_natural_foundation_interpretation.schema.json",
  "title": "RangeMatchAdvisorNaturalFoundationInterpretation",
  "description": "Phase 6 LLM advisor interpretation of a deterministic Natural Cattle Profile. LLM may narrate; it may not author facts, status, or tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interpretation_id",
    "run_id",
    "deal_context_version",
    "natural_cattle_profile_hash",
    "status",
    "controlling_factor",
    "land_character",
    "advisor_judgment",
    "operating_possibilities",
    "conditional_scenarios",
    "advisor_view",
    "integrated_natural_reading",
    "intended_use_interpretation",
    "what_would_change_the_view",
    "refinement_request",
    "optional_copy_ready_request",
    "cited_profile_refs",
    "knowledge_refs",
    "next_question",
    "source",
    "validation_status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "advisor_natural_foundation_interpretation@1.1.0"
    },
    "interpretation_id": { "type": "string", "minLength": 8 },
    "run_id": { "type": "string", "minLength": 8 },
    "deal_context_version": { "type": "integer", "minimum": 1 },
    "natural_cattle_profile_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    },
    "status": {
      "type": "string",
      "enum": [
        "PROMISING_NATURAL_FOUNDATION",
        "CONDITIONAL_NATURAL_FOUNDATION",
        "ENVIRONMENTALLY_CONSTRAINED",
        "INSUFFICIENT_ENVIRONMENTAL_EVIDENCE"
      ]
    },
    "controlling_factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "reason", "resolved"],
      "properties": {
        "domain": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "TERRAIN",
                "FEED_VEGETATION",
                "WATER",
                "CLIMATE_HAZARD",
                "SOIL_ECOLOGY"
              ]
            },
            { "type": "null" }
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "resolved": { "type": "boolean" }
      }
    },
    "land_character": { "type": "string", "minLength": 40, "maxLength": 1000 },
    "advisor_judgment": { "type": "string", "minLength": 30, "maxLength": 700 },
    "operating_possibilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 12, "maxLength": 260 }
    },
    "conditional_scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "minLength": 12, "maxLength": 300 }
    },
    "advisor_view": { "type": "string", "minLength": 20, "maxLength": 600 },
    "integrated_natural_reading": {
      "type": "string",
      "minLength": 40,
      "maxLength": 2000
    },
    "intended_use_interpretation": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "what_would_change_the_view": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    },
    "refinement_request": { "type": "string", "minLength": 12, "maxLength": 400 },
    "optional_copy_ready_request": {
      "type": ["string", "null"],
      "maxLength": 600
    },
    "cited_profile_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "knowledge_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "next_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "prompt",
        "allowed_field",
        "what_would_change_view_ref"
      ],
      "properties": {
        "question_id": { "type": "string", "minLength": 3 },
        "prompt": { "type": "string", "minLength": 12, "maxLength": 280 },
        "allowed_field": { "type": "string", "minLength": 3 },
        "what_would_change_view_ref": { "type": "string", "minLength": 3 }
      }
    },
    "source": {
      "type": "string",
      "enum": ["LIVE_LLM", "DETERMINISTIC_FALLBACK"]
    },
    "validation_status": {
      "type": "string",
      "enum": ["PASSED", "FAILED"]
    },
    "validation_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "created_at": { "type": "string", "minLength": 8 },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
