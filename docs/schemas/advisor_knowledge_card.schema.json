{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rangematch.local/schemas/advisor_knowledge_card.schema.json",
  "title": "RangeMatchAdvisorKnowledgeCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_id",
    "topic",
    "statement",
    "source_id",
    "source_title",
    "source_url_or_citation",
    "source_publisher",
    "source_date",
    "reviewed_by",
    "reviewed_at",
    "review_basis",
    "effective_jurisdictions",
    "species_scope",
    "review_status",
    "allowed_use",
    "prohibited_use",
    "content_hash",
    "expires_or_review_after",
    "version"
  ],
  "properties": {
    "knowledge_id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "topic": {
      "type": "string",
      "enum": [
        "livestock_water",
        "legal_access",
        "forage_or_rap",
        "field_task_boundary"
      ]
    },
    "statement": { "type": "string", "minLength": 40 },
    "source_id": { "type": "string", "minLength": 1 },
    "source_title": { "type": "string", "minLength": 1 },
    "source_url_or_citation": { "type": "string", "minLength": 1 },
    "source_publisher": { "type": "string", "minLength": 1 },
    "source_date": { "type": "string", "minLength": 4 },
    "reviewed_by": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "minLength": 8 },
    "review_basis": { "type": "string", "minLength": 1 },
    "effective_jurisdictions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "species_scope": {
      "type": "array",
      "items": { "type": "string", "enum": ["cattle", "sheep"] }
    },
    "review_status": {
      "type": "string",
      "enum": ["APPROVED", "PROVISIONAL_FOR_CPER_TEST", "DRAFT", "EXPIRED"]
    },
    "allowed_use": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["diligence_question", "conditional_reasoning", "domain_prior"]
      }
    },
    "prohibited_use": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["parcel_fact", "suitability_verdict", "legal_conclusion"]
      }
    },
    "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "expires_or_review_after": { "type": "string", "minLength": 8 },
    "version": { "type": "string" }
  }
}
